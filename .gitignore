/target
# Local agent builds; releases build and publish their own
/dist/
apps/tray/Autobahn.app/

# TLC scratch (spec/check.sh)
spec/states/

# The benchmark harness: hundreds of megabytes of corpora and run
# output, and nothing a build or a release needs. The figures it
# produces are committed, under benchmarks/.
/bench/

# The dash window's bundle and its build directory: the script makes
# both, and neither belongs in the repository.
apps/dash/Autobahn Dash.app/

# The documentation site, built by `mkdocs build` and published by Pages.
# Generated from docs/ on every deploy; nothing reads it from here.
/site/

# Python bytecode from the MkDocs build hook (scripts/mkdocs_hooks.py).
__pycache__/
